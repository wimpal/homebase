# Database (used by docker-compose — keep in sync with POSTGRES_* below)
DATABASE_URL="postgresql://homebase:CHANGE_ME@localhost:5432/homebase?schema=public"

# Docker Compose — Postgres container
POSTGRES_USER=homebase
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=homebase

# App
APP_PORT=3000
AUTH_SECRET=generate-a-long-random-string-here
# IMPORTANT: use your NAS LAN IP or hostname, not localhost
AUTH_URL=http://192.168.1.50:3000

# Redis (internal to Docker network)
REDIS_URL=redis://localhost:6379

# Web Push (optional — run: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@homebase.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Uploads (local dev only — Docker uses a volume)
UPLOAD_DIR=./uploads

# Philips Hue (optional — use your bridge's LAN IP)
HUE_BRIDGE_IP=
HUE_USERNAME=

# IKEA Dirigera (optional — pair with: npx dirigera authenticate)
# NAS app container must reach https://<DIRIGERA_IP>:8443 on the home LAN
DIRIGERA_IP=
DIRIGERA_TOKEN=
# Smoke toggle: pin a lamp NOT in daily use (e.g. office desk). Required for write smoke only.
# DIRIGERA_TEST_DEVICE_ID=
# Local mcp:smoke write round-trip (off/on on pinned device only). Never set on NAS deploy path.
# Post-deploy MCP smoke (deploy:nas) is list-only and must not toggle household lamps (T-038).
# HOMEBASE_SMOKE_LIGHTS_WRITE=1
# Or: npm run mcp:smoke:full  (sets write flag; still requires DIRIGERA_TEST_DEVICE_ID)

# MCP (Mimir integration — bearer auth on /mcp; /health stays public)
SERVICE_TOKEN=generate-a-long-random-string-here
# Household cuid for MCP tool calls (after seed: npx tsx scripts/print-household-id.ts)
MCP_HOUSEHOLD_ID=
# MCP_SHOPPING_LIST_ID=   # optional — override primary shopping list

# NAS deploy (optional — gitignored .env on Windows dev machine; scripts/deploy-nas.ps1)
# PC setup (SSH key, docker group): docs/nas-pc-setup.md
# NAS_HOST=192.168.1.142
# NAS_USER=wim
# NAS_PATH=/volume1/docker/homebase
# NAS_SHARE=\\192.168.1.142\docker\homebase
# NAS_BRANCH=main
# NAS_SSH_PORT=22
