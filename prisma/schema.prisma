generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

enum ModuleId {
  INVENTORY
  SHOPPING
  TASKS
  PLANTS
  PETS
  CALENDAR
  ROUTINES
  RECIPES
  BUDGET
  DELIVERY
  SMART_HOME
  MESSAGING
}

enum NotificationType {
  INFO
  WARNING
  REMINDER
  LOW_STOCK
  EXPIRY
  DELIVERY
  TASK
}

enum RequestType {
  GROCERY
  TASK
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
}

enum DeviceType {
  SENSOR
  LIGHT
  CAMERA
  OTHER
}

/// Time-based vs Dirigera sensor-edge Automations (M4c).
enum LightAutomationTriggerKind {
  SCHEDULE
  SENSOR_EDGE
  BUTTON
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  /// Calendar date only (T-092 Account birthday). Display as DD-MM-YYYY in UTC.
  birthday       DateTime? @db.Date
  /// Bumped on password change to revoke JWTs (T-092).
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  notifications       Notification[]
  preferences         Preference[]
  choreCompletions    ChoreCompletion[]
  projectUpdates      ProjectUpdate[]
  projectFiles        ProjectFile[]
  plantLogs           PlantLog[]
  routineMembers      RoutineMember[]
  routineCompletions  RoutineTaskCompletion[]
  messages            Message[]
  requests            Request[]
  points              UserPoints?
  badges              UserBadge[]
  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]
}

/// Opaque password-reset tokens hashed at rest (T-092). Bound to userId, not email.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  /// Home coords for Sunset link (T-087 / M4d). Null = adjuster skips linked rules.
  latitude  Float?
  longitude Float?
  /// IANA timezone for household geo docs; schedule rules still use LightAutomation.timezone.
  timezone  String   @default("Europe/Amsterdam")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  moduleSettings            ModuleSetting[]
  notifications             Notification[]
  notificationTypeSettings  NotificationTypeSetting[]
  preferences               Preference[]
  locations        Location[]
  products         Product[]
  stockItems       StockItem[]
  shoppingLists    ShoppingList[]
  stores           Store[]
  budgets          Budget[]
  expenses         Expense[]
  chores           Chore[]
  projects         Project[]
  plants           Plant[]
  pets             Pet[]
  calendarEvents   CalendarEvent[]
  routines         Routine[]
  routineTemplates RoutineTemplate[]
  eventLogs        EventLog[]
  recipes          Recipe[]
  leftovers        Leftover[]
  devices          Device[]
  lightAutomations LightAutomation[]
  sensorReadings   SensorReading[]
  messages         Message[]
  requests         Request[]
  visitorPrefs     VisitorPreference[]
  deliveries       DeliveryPackage[]
  mcpChangeLogs    McpChangeLog[]
  purchaseEvents   PurchaseEvent[]
}

model McpChangeLog {
  id          String    @id @default(cuid())
  householdId String
  toolName    String
  entityType  String
  entityId    String
  payloadJson Json
  createdAt   DateTime  @default(now())
  revertedAt  DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt(sort: Desc)])
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
}

model ModuleSetting {
  id          String   @id @default(cuid())
  householdId String
  moduleId    ModuleId
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, moduleId])
}

model Notification {
  id          String           @id @default(cuid())
  householdId String
  userId      String?
  type        NotificationType @default(INFO)
  title       String
  message     String
  read        Boolean          @default(false)
  link        String?
  /// Stable once-per-event key; null = one-off (no dedupe). Unique per household when set.
  dedupeKey   String?
  createdAt   DateTime         @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([householdId, dedupeKey])
  @@index([householdId, createdAt(sort: Desc)])
}

/// Per-type mute for household Home Feed. Missing row = enabled.
model NotificationTypeSetting {
  id          String           @id @default(cuid())
  householdId String
  type        NotificationType
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, type])
}

model Preference {
  id          String @id @default(cuid())
  userId      String
  householdId String
  key         String
  value       String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId, key])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id          String @id @default(cuid())
  householdId String
  name        String

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  stockItems StockItem[]
}

model Product {
  id                   String    @id @default(cuid())
  householdId          String
  name                 String
  description          String?
  category             String?
  lowStockAt           Int       @default(1)
  autoAddWhenLowStock  Boolean   @default(false)
  lastPurchasedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  household          Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  barcodes           Barcode[]
  stockItems         StockItem[]
  recipeIngredients  RecipeIngredient[]
  shoppingItems      ShoppingItem[]
  purchaseEvents     PurchaseEvent[]
}

model Barcode {
  id        String @id @default(cuid())
  productId String
  code      String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockItem {
  id          String    @id @default(cuid())
  householdId String
  productId   String
  locationId  String?
  quantity    Int       @default(0)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
}

model ShoppingList {
  id          String   @id @default(cuid())
  householdId String
  name        String   @default("Shopping List")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
}

model Store {
  id          String @id @default(cuid())
  householdId String
  name        String

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingItem[]
}

model ShoppingItem {
  id             String   @id @default(cuid())
  shoppingListId String
  productId      String
  name           String
  quantity       Int      @default(1)
  checked        Boolean  @default(false)
  tags           String[]
  storeId        String?
  autoAdded      Boolean  @default(false)
  createdAt      DateTime @default(now())

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@unique([shoppingListId, productId])
}

model PurchaseEvent {
  id          String   @id @default(cuid())
  householdId String
  productId   String
  quantity    Int      @default(1)
  purchasedAt DateTime @default(now())
  source      String   @default("manual")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([householdId, productId, purchasedAt])
}

model Budget {
  id          String   @id @default(cuid())
  householdId String
  name        String
  category    String
  amount      Float
  period      String   @default("monthly")
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  expenses  Expense[]
}

model Expense {
  id          String   @id @default(cuid())
  householdId String
  budgetId    String?
  description String
  amount      Float
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  budget    Budget?   @relation(fields: [budgetId], references: [id], onDelete: SetNull)
}

model Chore {
  id           String    @id @default(cuid())
  householdId  String
  title        String
  description  String?
  intervalDays Int?
  nextDue      DateTime?
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  completions ChoreCompletion[]
}

model ChoreCompletion {
  id          String    @id @default(cuid())
  choreId     String
  userId      String?
  durationMin Int?
  startedAt   DateTime?
  completedAt DateTime  @default(now())
  notes       String?

  chore Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Project {
  id          String   @id @default(cuid())
  householdId String
  title       String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household      Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  workItems      ProjectWorkItem[]
  files          ProjectFile[]
  visionPins     ProjectVisionPin[]
  visionPinLinks ProjectVisionPinLink[]
  updates        ProjectUpdate[]
}

model ProjectWorkItem {
  id        String   @id @default(cuid())
  projectId String
  title     String
  notes     String?
  status    String   @default("backlog")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, order])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  userId       String?
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model ProjectVisionPin {
  id        String   @id @default(cuid())
  projectId String
  kind      String
  body      String?
  imageUrl  String?
  xPct      Float    @default(10)
  yPct      Float    @default(10)
  wPct      Float    @default(18)
  hPct      Float    @default(22)
  zIndex    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linksFrom ProjectVisionPinLink[] @relation("VisionPinLinkFrom")
  linksTo   ProjectVisionPinLink[] @relation("VisionPinLinkTo")

  @@index([projectId])
}

model ProjectVisionPinLink {
  id        String   @id @default(cuid())
  projectId String
  fromPinId String
  toPinId   String
  createdAt DateTime @default(now())

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromPin ProjectVisionPin @relation("VisionPinLinkFrom", fields: [fromPinId], references: [id], onDelete: Cascade)
  toPin   ProjectVisionPin @relation("VisionPinLinkTo", fields: [toPinId], references: [id], onDelete: Cascade)

  @@unique([fromPinId, toPinId])
  @@index([projectId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  comment   String
  photoUrl  String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Plant {
  id             String    @id @default(cuid())
  householdId    String
  name           String
  species        String?
  wateringDays   Int       @default(7)
  lastWatered    DateTime?
  nextWatering   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  logs      PlantLog[]
}

model PlantLog {
  id        String   @id @default(cuid())
  plantId   String
  userId    String?
  photoUrl  String?
  notes     String?
  createdAt DateTime @default(now())

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Pet {
  id          String   @id @default(cuid())
  householdId String
  name        String
  species     String?
  breed       String?
  birthDate   DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  household    Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  appointments PetAppointment[]
  feedingRoutines FeedingRoutine[]
}

model PetAppointment {
  id        String   @id @default(cuid())
  petId     String
  title     String
  date      DateTime
  location  String?
  notes     String?
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model FeedingRoutine {
  id        String @id @default(cuid())
  petId     String
  name      String
  timeOfDay String
  amount    String?
  notes     String?

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id              String   @id @default(cuid())
  householdId     String
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime?
  atHome          Boolean  @default(true)
  reminderMinutes Int      @default(60)
  itemsNeeded     String[]
  createdAt       DateTime @default(now())

  household Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  guests    EventGuest[]
}

model EventGuest {
  id      String @id @default(cuid())
  eventId String
  name    String
  notes   String?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Routine {
  id          String   @id @default(cuid())
  householdId String
  name        String
  description String?
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  members   RoutineMember[]
  tasks     RoutineTask[]
}

model RoutineMember {
  id        String @id @default(cuid())
  routineId String
  userId    String
  role      String @default("member")

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routineId, userId])
}

model RoutineTask {
  id              String  @id @default(cuid())
  routineId       String
  title           String
  notes           String?
  attachmentUrl   String?
  recurrence      String  @default("daily")
  reminderMinutes Int?
  points          Int     @default(10)
  order           Int     @default(0)

  routine     Routine                  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  dependsOn   RoutineTaskDependency[] @relation("DependentTask")
  requiredBy  RoutineTaskDependency[]  @relation("RequiredTask")
  completions RoutineTaskCompletion[]
}

model RoutineTaskDependency {
  id              String @id @default(cuid())
  taskId          String
  dependsOnTaskId String

  task          RoutineTask @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask RoutineTask @relation("RequiredTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
}

model RoutineTaskCompletion {
  id          String   @id @default(cuid())
  taskId      String
  userId      String?
  durationMin Int?
  completedAt DateTime @default(now())

  task RoutineTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model RoutineTemplate {
  id          String @id @default(cuid())
  householdId String
  name        String
  description String?

  household Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tasks     RoutineTemplateTask[]
}

model RoutineTemplateTask {
  id         String @id @default(cuid())
  templateId String
  title      String
  recurrence String @default("daily")
  order      Int    @default(0)

  template RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model EventLog {
  id          String   @id @default(cuid())
  householdId String
  title       String
  description String?
  occurredAt  DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model UserPoints {
  id        String @id @default(cuid())
  userId    String @unique
  points    Int    @default(0)
  streak    Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  icon        String @default("star")

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Recipe {
  id           String   @id @default(cuid())
  householdId  String
  title        String
  instructions String
  servings     Int      @default(4)
  tags         String[] @default([])
  calories     Float?
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  timers      RecipeTimer[]
  leftovers   Leftover[]
}

model RecipeIngredient {
  id        String  @id @default(cuid())
  recipeId  String
  productId String?
  name      String
  quantity  String
  group     String?
  optional  Boolean @default(false)

  recipe  Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model RecipeStep {
  id        String  @id @default(cuid())
  recipeId  String
  text      String
  optional  Boolean @default(false)
  sortOrder Int     @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, sortOrder])
}

model RecipeTimer {
  id       String @id @default(cuid())
  recipeId String
  label    String
  minutes  Int

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Leftover {
  id          String    @id @default(cuid())
  householdId String
  recipeId    String?
  name        String
  servings    Int       @default(1)
  frozenAt    DateTime  @default(now())
  expiresAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model Device {
  id          String     @id @default(cuid())
  householdId String
  name        String
  type        DeviceType @default(OTHER)
  config      Json?
  enabled     Boolean    @default(true)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

/// IKEA light Automation (M4c): schedule and/or sensor-edge. Not a chore Routine.
model LightAutomation {
  id              String   @id @default(cuid())
  householdId     String
  name            String
  enabled         Boolean  @default(true)

  triggerKind LightAutomationTriggerKind @default(SCHEDULE)

  /// Wall-clock "HH:MM" (24h); evaluated in `timezone` (T-066). Null for SENSOR_EDGE.
  timeLocal       String?
  /// ISO weekdays: 1=Mon … 7=Sun. Empty for SENSOR_EDGE.
  daysOfWeek      Int[]
  timezone        String   @default("Europe/Amsterdam")

  /// Optional active window "HH:MM" (local). Both null = all day.
  activeFromLocal  String?
  activeUntilLocal String?

  /// Dirigera sensor device id (SENSOR_EDGE only).
  sensorDirigeraDeviceId String?
  /// Edge attribute: "isOpen" | "isDetected" (SENSOR_EDGE only).
  sensorEdgeAttribute    String?
  /// "rising" (opens/detects) or "falling" (closes/clears). Default rising.
  sensorEdgePolarity     String?  @default("rising")

  /// Dirigera controller/button device id (BUTTON only). Bilresa = one id per physical button.
  buttonDirigeraDeviceId String?
  /// Press identity: clickPattern singlePress | doublePress | longPress (BUTTON only).
  buttonIdentity         String?

  on              Boolean
  /// When true (SENSOR_EDGE): leave-session occupancy (not edge-flip).
  toggle          Boolean  @default(false)
  /// Leave-session state for toggle rules: null/idle | occupied | leaving.
  toggleSession   String?
  brightness      Int?
  colorTempKelvin Int?

  /// Sunset link (M4d): daily adjuster rewrites timeLocal from sunset − offset.
  sunsetLinkEnabled     Boolean   @default(false)
  /// Minutes before local sunset; required when sunsetLinkEnabled (0–180).
  minutesBeforeSunset   Int?
  sunsetLastAdjustAt    DateTime?
  sunsetLastAdjustResult String?

  lastRunAt       DateTime?
  lastRunResult   String?
  /// Local slot key claimed by T-066 before apply, e.g. "2026-09-13T21:00".
  lastFiredSlot   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  targets   LightAutomationTarget[]

  @@index([householdId, enabled])
  @@index([sensorDirigeraDeviceId, enabled])
  @@index([buttonDirigeraDeviceId, enabled])
}

model LightAutomationTarget {
  id               String @id @default(cuid())
  automationId     String
  dirigeraDeviceId String

  automation LightAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, dirigeraDeviceId])
}

model SensorReading {
  id          String   @id @default(cuid())
  householdId String
  deviceId    String?
  temperature Float?
  humidity    Float?
  airQuality  Float?
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Message {
  id          String   @id @default(cuid())
  householdId String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Request {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  type        RequestType
  title       String
  description String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisitorPreference {
  id          String @id @default(cuid())
  householdId String
  visitorName String
  preferences Json

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, visitorName])
}

model DeliveryPackage {
  id              String         @id @default(cuid())
  householdId     String
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  description     String?
  status          DeliveryStatus @default(PENDING)
  expectedDate    DateTime?
  earliestTime    DateTime?
  latestTime      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
